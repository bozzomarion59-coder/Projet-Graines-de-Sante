/* CREATION DE LA BASE DE DONNEES */

CREATE DATABASE gluten_free_recipes;
USE gluten_free_recipes;


/* TABLE : users */

CREATE TABLE users (
    id_user INT AUTO_INCREMENT PRIMARY KEY,
    email_user VARCHAR(255) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    pseudo_user VARCHAR(100) NOT NULL,
    role_user ENUM('user','admin') NOT NULL DEFAULT 'user',
    create_at_user DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
);


/* TABLE : categories_recipes */

CREATE TABLE categories_recipes (
    id_categorie INT AUTO_INCREMENT PRIMARY KEY,
    name_categorie ENUM('entree','plat','dessert','boisson') NOT NULL UNIQUE
);

-- Insertion des catégories
INSERT INTO categories_recipes (name_categorie)
VALUES ('entree'), ('plat'), ('dessert'), ('boisson');


/* TABLE : recipes */

CREATE TABLE recipes (
    id_recipe INT AUTO_INCREMENT PRIMARY KEY,
    categorie_id INT NOT NULL,
    title_recipe VARCHAR(255) NOT NULL UNIQUE,
    description TEXT NOT NULL,
    instructions TEXT NOT NULL,
    image_png VARCHAR(255) NOT NULL,
    preparation_time INT NOT NULL,
    cooking_time INT DEFAULT NULL,
    create_at_recipe DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- Relation : recettes et catégories
ALTER TABLE recipes
ADD CONSTRAINT fk_recipe_categorie
FOREIGN KEY (categorie_id)
REFERENCES categories_recipes(id_categorie);


/* TABLE : ingredients */

CREATE TABLE ingredients (
    id_ingredient INT AUTO_INCREMENT PRIMARY KEY,
    name_ingredient VARCHAR(255) NOT NULL
);

